# ---------------------------------------------------------------
# Python
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# 가상환경
.venv/
venv/
env/
ENV/

# ---------------------------------------------------------------
# Jupyter
# ---------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# 주의: notebooks/*.ipynb 자체는 추적한다.
# 실행 결과(출력 셀)가 실험 기록의 일부이므로 커밋에 포함한다.
# 다만 diff가 지나치게 커지면 nbstripout 도입을 검토할 것.

# ---------------------------------------------------------------
# 인증 정보 — 절대 커밋하지 않는다
# ---------------------------------------------------------------
# D-Wave API 토큰
.dwaverc
dwave.conf
# Gurobi 라이선스
gurobi.lic
*.lic
# 일반 환경변수 파일
.env
.env.*
!.env.example
*token*
*secret*
*credential*

# ---------------------------------------------------------------
# 재생성 가능한 중간 산출물
# ---------------------------------------------------------------
# Gurobi/SA의 해 배열. notebook 02, 04를 다시 실행하면 복원된다.
# 용량이 크고 diff가 무의미한 바이너리이므로 제외한다.
results/raw/solutions/
*.npz

# 생성된 instance. seed가 config에 고정되어 있어
# notebook 01로 항상 동일하게 재생성된다.
data/generated/*.json

# ---------------------------------------------------------------
# 추적하는 결과물 (재현 없이도 결과를 볼 수 있어야 한다)
# ---------------------------------------------------------------
# results/raw/*.csv          단계별 원자료
# results/raw/*.txt          검증 로그
# results/processed/*        통합 결과, 요약, 실행 기록
# results/figures/*.png      README가 참조하는 figure
#
# 위 항목들은 의도적으로 ignore하지 않는다. 저장소를 clone한 사람이
# Gurobi 라이선스나 D-Wave 토큰 없이도 결과를 확인할 수 있어야 한다.

# ---------------------------------------------------------------
# 편집기 / OS
# ---------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---------------------------------------------------------------
# 임시 파일
# ---------------------------------------------------------------
*.log
!results/raw/verification_log.txt
*.tmp
tmp/
scratch/